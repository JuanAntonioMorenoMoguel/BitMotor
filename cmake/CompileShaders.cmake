# Compiles BitMotor's own shaders (src/Render/Shaders/*.vert, *.frag) to SPIR-V and writes them as C++
# arrays in src/Render/Shaders/Compiled.h, which is committed: building BitMotor or a game never needs a
# shader compiler. Run it after changing a shader (needs glslc or glslangValidator from the Vulkan SDK):
#     cmake -P cmake/CompileShaders.cmake
cmake_minimum_required(VERSION 3.25)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(folder "${root}/src/Render/Shaders")

find_program(GLSLC glslc HINTS "$ENV{VULKAN_SDK}/bin" "$ENV{VULKAN_SDK}/Bin")
find_program(GLSLANG glslangValidator HINTS "$ENV{VULKAN_SDK}/bin" "$ENV{VULKAN_SDK}/Bin")
if(NOT GLSLC AND NOT GLSLANG)
    message(FATAL_ERROR "Neither glslc nor glslangValidator found (install the Vulkan SDK)")
endif()

file(GLOB shaders "${folder}/*.vert" "${folder}/*.frag" "${folder}/*.comp")
list(SORT shaders)
set(out "// Generated by cmake/CompileShaders.cmake from the shaders in this folder. Do not edit by hand.\n")
string(APPEND out "#pragma once\n#include <cstdint>\n\nnamespace BitMotor::Detail::Shaders {\n")
foreach(shader ${shaders})
    get_filename_component(name "${shader}" NAME_WE)
    get_filename_component(ext "${shader}" EXT)
    string(SUBSTRING "${ext}" 1 1 first)
    string(TOUPPER "${first}" first)
    string(SUBSTRING "${ext}" 2 -1 rest)
    set(symbol "${name}${first}${rest}") # Fill.frag -> FillFrag
    set(spv "${CMAKE_BINARY_DIR}/BitMotorShader_${name}${ext}.spv")
    if(GLSLC)
        execute_process(COMMAND "${GLSLC}" --target-env=vulkan1.0 -O "${shader}" -o "${spv}" RESULT_VARIABLE failed)
    else()
        execute_process(COMMAND "${GLSLANG}" -V --target-env vulkan1.0 "${shader}" -o "${spv}" OUTPUT_QUIET RESULT_VARIABLE failed)
    endif()
    if(failed)
        message(FATAL_ERROR "Could not compile ${shader}")
    endif()
    file(READ "${spv}" hex HEX)
    file(REMOVE "${spv}")
    # SPIR-V is little-endian 32-bit words: bytes aa bb cc dd -> 0xddccbbaa.
    string(REGEX MATCHALL "........" chunks "${hex}")
    set(words "")
    set(count 0)
    foreach(chunk ${chunks})
        string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1," word "${chunk}")
        if(count GREATER 0 AND count EQUAL 8)
            string(APPEND words "\n    ")
            set(count 0)
        endif()
        string(APPEND words "${word}")
        math(EXPR count "${count} + 1")
    endforeach()
    string(APPEND out "\n// ${name}${ext}\ninline constexpr std::uint32_t ${symbol}[] = {\n    ${words}\n};\n")
    message(STATUS "${name}${ext} -> ${symbol}")
endforeach()
string(APPEND out "\n} // namespace BitMotor::Detail::Shaders\n")
file(WRITE "${folder}/Compiled.h" "${out}")
